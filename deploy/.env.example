# Private Tasks configuration.
# Copy this file to .env, fill in every value, and keep .env private.

# --- Your account ---------------------------------------------------------

# Username for signing in.
PT_USERNAME=me

# Argon2 hash of your password. Generate it with:
#   docker compose run --rm app hash-password
# The hash contains "$" characters, so keep it inside single quotes;
# otherwise Docker Compose tries to expand them as variables.
PT_PASSWORD_HASH='paste-the-generated-hash-here'

# Long random key used to sign undo tokens. Generate it with:
#   openssl rand -hex 32
PT_SECRET_KEY=change-me

# --- General --------------------------------------------------------------

# Initial timezone (IANA name). It can be changed later in Settings.
# Set it correctly before importing from Google Takeout.
PT_TIMEZONE=Europe/Madrid

# IP address or network of your reverse proxy. Only requests coming from it
# may set X-Forwarded-For, which the sign-in rate limit relies on.
# Leave empty when using the bundled Caddy.
PT_TRUSTED_PROXIES=

# --- Database -------------------------------------------------------------

POSTGRES_DB=private_tasks
POSTGRES_USER=private_tasks
# Generate a strong password, for example with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- Bundled Caddy (only with: docker compose --profile caddy up -d) -------

# Domain pointing to this server. Caddy gets the HTTPS certificate for it.
PT_DOMAIN=tasks.example.com
